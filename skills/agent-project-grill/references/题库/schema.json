 "item_relation_schema": {
  "type": "object",
  "required": [
   "target",
   "direction",
   "type",
   "reason"
  ],
  "properties": {
   "target": {
    "type": "string",
    "pattern": "^L\\d+$",
    "description": "关联目标题目 ID"
   },
   "direction": {
    "type": "string",
    "enum": [
     "in",
     "out"
    ],
    "description": "边方向：in 为输入前置 (target -> self)；out 为输出递进 (self -> target)"
   },
   "type": {
    "type": "string",
    "enum": [
     "hard_prereq",
     "progressive"
    ],
    "description": "关系类型：hard_prereq (前置基础) 或 progressive (建议递进)"
   },
   "reason": {
    "type": "string",
    "description": "简要关系理由与场景依据"
   }
  }
 }
